# Copier ce fichier en `.env` à la racine du repo, puis renseigner les
# valeurs ci-dessous.
#   cp .env.example .env        # macOS/Linux
#   copy .env.example .env      # Windows (cmd)
#   Copy-Item .env.example .env # Windows (PowerShell)
#
# Ce fichier est lu par tous les services backend (voir scripts/run_backend.py
# et docker-compose.yml) ET par le frontend Vite pour les variables VITE_*
# (voir frontend/vite.config.ts — envDir = racine du repo).

# --- Base de données --------------------------------------------------------
DB_PASSWORD=changeme
# Hostname `db` = réseau Docker Compose (utilisé par les conteneurs backend).
# En dev local (agents lancés hors Docker via dev.ps1/dev.sh), le script
# réécrit automatiquement vers localhost:5434 si `db` n'est pas résolvable.
DATABASE_URL=postgresql://agriadvisor:changeme@db:5432/agriadvisor

# --- Auth --------------------------------------------------------------------
# Générez un secret long et aléatoire (ex. `openssl rand -hex 32`).
JWT_SECRET_KEY=changeme-generate-a-long-random-secret

# --- LLM -----------------------------------------------------------------
# Clé API Mistral (https://console.mistral.ai) — requise pour tous les agents.
MISTRAL_API_KEY=

# --- APIs externes — Agriculture Advisor ------------------------------------
# Sentinel Hub (https://www.sentinel-hub.com) — imagerie satellite.
SENTINEL_HUB_CLIENT_ID=
SENTINEL_HUB_CLIENT_SECRET=
# SoilGrids, NASA POWER, Open-Meteo, Open-Elevation : pas de clé requise (APIs ouvertes)

# --- Frontend (Vite lit ces VITE_* depuis ce .env racine) -------------------
# Mapbox (https://www.mapbox.com) — vue terrain 3D (page /agriculture).
VITE_MAPBOX_TOKEN=
# Mode dev SANS backend Auth/Postgres (voir frontend/src/lib/auth-context.tsx).
# À laisser à `false` pour tester l'app normalement (vrai login).
VITE_SKIP_AUTH=false
VITE_SKIP_AUTH_ROLE=farmer

# --- APIs externes — Business / Marketplace (prix de marché) ---------------
RNM_FRANCEAGRIMER_API_KEY=
# Dossier partagé des données marché (FDS_IPPAP_*.csv + FranceAgriMer_*.pdf).
# Vide = valeur par défaut ./data
MARKET_DATA_DIR=
AGRESTE_DATA_DIR=
# Le RAG marché s'active automatiquement si un index Chroma existe + MISTRAL_API_KEY.
# Forcer à 0 pour désactiver.
MARKET_RAG_ENABLED=
FRANCEAGRIMER_PDF_DIR=

# --- Bourse Agricole & Vente à Terme (Agent Trading — port 8007) ------------
# Alpha Vantage (https://www.alphavantage.co) — cotations matières premières agricoles.
TRADING_DATA_MODE=franceagrimer_physical
# Physical FranceAgriMer weekly quotations only; not MATIF and not execution eligible.
# Update this dated RNM report URL before each weekly import.
FRANCEAGRIMER_RNM_REPORT_URL=
# Licensed-provider mode only: provider, with both fields required.
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_PROVIDER_API_KEY=
VITE_AGENT_TRADING_URL=http://localhost:8007

# ------------------------------------------------------------------------
# IMPORTANT — Agent Régulation et Agent Waste ont CHACUN leur propre .env
# (Qdrant Cloud + clé de recherche web), séparé de celui-ci :
#   backend/agent_regulation/.env   (copier depuis .env.example du dossier)
#   backend/waste_agents/.env       (copier depuis .env.example du dossier)
# Ces deux agents utilisent une base vectorielle Qdrant Cloud déjà provisionnée
# et pré-remplie (corpus réglementaire / base de connaissances déchets) — les
# identifiants ne peuvent pas être régénérés localement, demandez-les au
# porteur du projet plutôt que de créer un nouveau cluster Qdrant vide.
# ------------------------------------------------------------------------
