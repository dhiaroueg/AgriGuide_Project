# Copier en `.env.local` (ignoré par git) et adapter au besoin.

# URL du service backend/auth. Par défaut http://localhost:8001 si absent.
# VITE_AUTH_API_URL=http://localhost:8001

# URL de l'agent Agriculture (backend/agent_agriculture). Par défaut
# http://localhost:8002 si absent — voir son README pour le lancer en local.
# VITE_AGENT_AGRICULTURE_URL=http://localhost:8002

# URL de l'agent Business (backend/agent_business). Par défaut
# http://localhost:8000 si absent — voir son README pour le lancer en local.
# VITE_AGENT_BUSINESS_URL=http://localhost:8000

# URL de l'agent Monitoring (backend/agent_monitoring). Par défaut
# http://localhost:8003 si absent — voir son README pour le lancer en local.
# VITE_AGENT_MONITORING_URL=http://localhost:8003

# URL de l'agent Régulation (backend/agent_regulation). Par défaut
# http://localhost:8005 — distinct de Auth (8001).
# VITE_AGENT_REGULATION_URL=http://localhost:8005

# URL de l'agent Déchets / Valorisation (backend/waste_agents). Par défaut
# http://localhost:8004 — lecture de la base connaissances (pas de clé LLM).
# VITE_AGENT_WASTE_URL=http://localhost:8004

# URL de l'agent Weather / Dashboard Météo (backend/agent_weather). Par défaut
# http://localhost:8006 — Open-Meteo Forecast+Archive (sans clé).
# VITE_AGENT_WEATHER_URL=http://localhost:8006

# --- Mode dev SANS backend Auth / PostgreSQL ---------------------------------
# Utile pour tester une fonctionnalité isolée (ex. marketplace, business...)
# sans avoir à installer/lancer Docker, PostgreSQL et le service auth.
# Simule une connexion automatique avec un utilisateur fictif au chargement
# de l'app. N'appelle jamais l'API auth tant que ce flag est actif.
#
# À NE PAS committer activé, et à ne jamais utiliser en production.
# VITE_SKIP_AUTH=true
# VITE_SKIP_AUTH_ROLE=farmer   # ou "acheteur"
VITE_SKIP_AUTH=true
VITE_SKIP_AUTH_ROLE=farmer
